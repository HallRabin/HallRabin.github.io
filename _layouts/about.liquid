---
layout: default
---
<div class="post">
  <center>
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  </center>

  <article>

    <center>
    <div class="clearfix">{{ content }}</div>

    <img src="assets/img/prof_pic.jpg" style="max-width:300px;width:80%">

    </center>

  </article>
</div>
