---
layout: default
---
<div class="post">
  <center>

  <img src="assets/img/ring.jpg" style="max-width:300px;width:45%"> <img src="assets/img/jumping.jpg" style="max-width:300px;width:45%">

  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  </center>

  <article>

    <center>
    <div class="clearfix">{{ content }}</div>
    </center>

  </article>
</div>
